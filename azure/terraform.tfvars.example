# Azure Configuration
azure_region = "East US"

# Deploy into an existing resource group instead of creating one (optional)
# resource_group_name = "my-existing-rg"

# Project Configuration
environment   = "dev"
project_name  = "multi-cloud-terraform"
owner         = "DevOps Team"
cost_center   = "Engineering"

# Network Configuration
vnet_cidr              = "10.1.0.0/16"
public_subnet_cidr     = "10.1.1.0/24"
private_subnet_cidr    = "10.1.10.0/24"
database_subnet_cidr   = "10.1.100.0/24"

# Compute Configuration
web_vm_size     = "Standard_B1s"
app_vm_size     = "Standard_B2s"
web_vm_count    = 2
app_vm_count    = 2
admin_username  = "azureuser"
admin_password  = "<strong-password>"

# Database Configuration
db_sku_name                        = "B_Standard_B1ms" # MySQL Flexible Server SKU
db_storage_mb                      = 20480
db_name                           = "appdb"
db_username                       = "dbadmin"
db_backup_retention_days          = 7
db_geo_redundant_backup_enabled   = false

# Authentication (never commit real values).
# Easiest: run `az login` and set only subscription_id (or export ARM_SUBSCRIPTION_ID).
# To use a service principal, set all four, or export ARM_CLIENT_ID, ARM_CLIENT_SECRET,
# ARM_SUBSCRIPTION_ID and ARM_TENANT_ID instead (the usual setup for CI).
subscription_id = "<subscription-id>"
# client_id       = "<service-principal-app-id>"
# client_secret   = "<service-principal-secret>"
# tenant_id       = "<tenant-id>"
